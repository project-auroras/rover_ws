# Connection to the ArduPilot rover. Read by scripts/rover.sh (shell syntax, no spaces around =).
# Values detected with `scripts/rover.sh probe` on 2026-11-10.

# Telemetry radio (FTDI FT231X, SiK-type). by-id path survives replugging and other USB devices.
ROVER_PORT=/dev/serial/by-id/usb-FTDI_FT231X_USB_UART_DU0ENGAS-if00-port0
ROVER_BAUD=57600          # SiK radios: 57600. USB cable to the flight controller: 115200

ROVER_SYSID=1             # SYSID_THISMAV of the rover

# UDP outputs of the MAVLink router (MAVProxy) on this PC
MP_UDP_PORT=14550         # Mission Planner / QGroundControl
MAVROS_UDP_PORT=14555     # MAVROS

# ROS 2 domain of MAVROS and `rover.sh shell`. 0 is shared with other robots on the network.
# Any other ROS 2 machine must use the same value to see /mavros/*: export ROS_DOMAIN_ID=7
ROS_DOMAIN_ID=7

# Stream rate (Hz) requested to the rover when MAVROS connects. Keep it low over a 57600 radio.
STREAM_RATE=5
