# NTRIP caster of the ITACyL GNSS network (Castilla y León). Copy to config/ntrip.env (not in git).
# Account: https://gnss.itacyl.es/inscripcion (1 simultaneous connection per user).
# Write the password as is (with '@' if it has one); the script encodes it for the URL.
NTRIP_USER=tu_usuario
NTRIP_PASS=tu_contraseña
NTRIP_HOST=52.164.213.26   # ntrip.itacyl.es
NTRIP_PORT=2101
NTRIP_MOUNT=leon3m         # León station, RTCM 3.2 (VRS3M = network VRS, needs GGA position)
